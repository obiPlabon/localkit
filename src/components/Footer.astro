---
import { site } from '../data/site';
import { categories, liveTools } from '../data/tools';

// Group live tools by category; the biggest groups come first and get two list columns.
const groups = categories
  .map((c) => ({ ...c, items: liveTools.filter((t) => t.category === c.id) }))
  .filter((g) => g.items.length)
  .sort((a, b) => b.items.length - a.items.length);
---
<footer class="site">
  <div class="container top">
    <div class="about">
      <strong class="nm">{site.name}</strong>
      <p>{site.tagline}</p>
    </div>
    <p class="priv">🔒 Files are processed locally in your browser and never uploaded.</p>
  </div>
  <nav class="container groups" aria-label="All tools">
    {groups.map((g) => (
      <div class:list={['group', g.items.length > 5 && 'wide']}>
        <h3><a href={`/#cat-${g.id}`}>{g.name}</a></h3>
        <ul style={`--rows:${Math.ceil(g.items.length / 2)}`}>{g.items.map((t) => <li><a href={`/${t.slug}`}>{t.name}</a></li>)}</ul>
      </div>
    ))}
  </nav>
  <div class="container legal">© {new Date().getFullYear()} {site.name}. Free to use, no sign-up.</div>
</footer>
<style>
  footer.site { margin-top:var(--s-8); border-top:1px solid var(--border); background:var(--surface-2); padding-top:var(--s-7); }
  .top { display:flex; flex-wrap:wrap; gap:var(--s-3) var(--s-6); justify-content:space-between; align-items:flex-end; padding-bottom:var(--s-6); border-bottom:1px solid var(--border); }
  .about p { color:var(--muted); margin-top:var(--s-2); font-size:var(--text-sm); max-width:44ch; }
  .nm { font:500 var(--text-lg)/1 var(--font-display); color:var(--accent); }
  .priv { color:var(--text); font-size:var(--text-sm); }
  .groups { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:var(--s-6) var(--s-5); padding-top:var(--s-6); }
  .group.wide { grid-column:span 2; }
  .group.wide ul { grid-template-columns:repeat(2, minmax(0, 1fr)); grid-auto-flow:column; grid-template-rows:repeat(var(--rows), auto); }
  h3 { font:400 var(--text-xs)/1.3 var(--font-mono); text-transform:uppercase; letter-spacing:.08em; margin-bottom:var(--s-3); }
  h3 a { color:var(--muted); text-decoration:none; }
  h3 a:hover { color:var(--accent); }
  ul { list-style:none; margin:0; padding:0; display:grid; gap:var(--s-2) var(--s-4); }
  li a { color:var(--text); text-decoration:none; font-size:var(--text-sm); }
  li a:hover { color:var(--accent); }
  .legal { margin-top:var(--s-6); padding-block:var(--s-5); border-top:1px solid var(--border); color:var(--muted); font:400 var(--text-xs)/1.4 var(--font-mono); text-transform:uppercase; letter-spacing:.06em; }
  @media (max-width:900px) { .groups { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
  @media (max-width:480px) { .group.wide { grid-column:1/-1; } }
</style>
