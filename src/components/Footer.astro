---
import { site } from '../data/site';
import { categories, liveTools } from '../data/tools';
---
<footer class="site">
  <div class="container grid">
    <div class="about">
      <strong class="nm">{site.name}</strong>
      <p>{site.tagline}</p>
      <p class="priv">🔒 Files are processed locally in your browser and never uploaded.</p>
    </div>
    <div>
      <h3>Tools</h3>
      <ul>{liveTools.map((t) => <li><a href={`/${t.slug}`}>{t.name}</a></li>)}</ul>
    </div>
    <div>
      <h3>Categories</h3>
      <ul>{categories.map((c) => <li><a href={`/#cat-${c.id}`}>{c.name}</a></li>)}</ul>
    </div>
  </div>
  <div class="container legal">© {new Date().getFullYear()} {site.name}. Free to use, no sign-up.</div>
</footer>
<style>
  footer.site { margin-top:var(--s-8); border-top:1px solid var(--border); background:var(--surface-2); padding-top:var(--s-7); }
  .grid { display:grid; grid-template-columns:1.6fr 1fr 1fr; gap:var(--s-6); }
  .about p { color:var(--muted); margin-top:var(--s-2); font-size:var(--text-sm); max-width:34ch; }
  .nm { font:500 var(--text-lg)/1 var(--font-display); color:var(--accent); }
  .priv { color:var(--text) !important; }
  h3 { font:400 var(--text-xs)/1.3 var(--font-mono); text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin-bottom:var(--s-3); }
  ul { list-style:none; margin:0; padding:0; display:grid; gap:var(--s-2); }
  li a { color:var(--text); text-decoration:none; font-size:var(--text-sm); }
  li a:hover { color:var(--accent); }
  .legal { margin-top:var(--s-6); padding-block:var(--s-5); border-top:1px solid var(--border); color:var(--muted); font:400 var(--text-xs)/1.4 var(--font-mono); text-transform:uppercase; letter-spacing:.06em; }
  @media (max-width:640px) { .grid { grid-template-columns:1fr 1fr; } .about { grid-column:1/-1; } }
</style>
